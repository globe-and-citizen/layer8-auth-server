# App
APP_ENV=development
SERVER_HOST=localhost
SERVER_PORT=5001

TOKENS_ISSUER=https://layer8proxy.net
CORS_ORIGINS=*.layer8proxy.net;http://localhost:5173

SCRAM_ITERATION_COUNT=4096

GENERATE_NEW_ZK_SNARKS_KEYS=true

# Log config
LOG_LEVEL=info
LOG_SERVICE_NAME=layer8-server
# json or text, default is text
LOG_FORMAT=json
# stdout or file, default is stdout
LOG_OUTPUT=stdout
LOG_FILE_PATH=./tmp/layer8-server.log

# Frontend configuration
STATIC_ASSETS_PATH=./web/dist/assets
SPA_INDEX_PATH=./web/dist/index.html
BASE_API_URL=
CONTRACT_ADDRESS=
WALLET_PROJECT_ID=

# Database
DB_HOST=10.10.10.105
DB_PORT=5432
DB_USER=layer8
DB_PASSWORD=layer81234
DB_NAME=layer8db
DB_SSL_MODE=
DB_MIGRATE_PATH=

# User configuration
USER_JWT_SECRET=

## Email configuration
MAILER_SEND_API_KEY=
MAILER_SEND_TEMPLATE_ID=
LAYER8_EMAIL_USERNAME=
LAYER8_EMAIL_DOMAIN=
EMAIL_VERIFICATION_CODE_EXPIRY=5m

## Phone verification
TELEGRAM_API_KEY=
PHONE_VERIFICATION_CODE_EXPIRY=5m

# Client configuration
CLIENT_JWT_SECRET=
UPDATE_USAGE_INTERVAL=30s
COST_PER_BILLING_UNIT=1
BYTES_PER_BILLING_UNIT=1024
PAYMENT_CURRENCY=usdc

## InfluxDB configuration
INFLUXDB_URL=http://10.10.10.104:8086
INFLUXDB_ORG=layer8
INFLUXDB_BUCKET=layer8
INFLUXDB_TOKEN=

## Ethereum and Smart Contract configuration
 WEB3_WS_RPC_URL=wss://polygon-mainnet.g.alchemy.com/v2/3nAO4RbKoWXgNDwEFWTH5
#WEB3_WS_RPC_URL=wss://polygon-mainnet.g.alchemy.com/v2/onXhkrr3bvgDInb9ewOhf
#WEB3_PAYMENT_CONTRACT_ADDRESS=0x52dCffA0D2C414eD0162fe78a9F870AbB2575A1f
#WEB3_PAYMENT_CONTRACT_ABI=./smart-contract/abi/L8TrafficPayment.json
WEB3_CNC_PAYMENT_ENABLED=true
WEB3_CNC_CONTRACT_ADDRESS=0xae40833AFEa9c37E5dF0fC69dC7dC6750EfD6D49
WEB3_CNC_EVENT_ABI=./smart-contract/abi/CNCTokenDepositedEvent.json

# OAuth configuration
OAUTH_COOKIE_MAX_AGE=3600
OAUTH_JWT_SECRET=
OAUTH_ACCESS_TOKEN_SECRET=lsdjfdslkjfkdls
OAUTH_AUTHZ_CODE_SECRET=sdlkjfldskjflksdjfklds
OAUTH_AUTHZ_CODE_EXPIRY=10m
OAUTH_ACCESS_TOKEN_EXPIRY=1h
OAUTH_ID_TOKEN_SECRET=
OAUTH_ID_TOKEN_EXPIRY=10m

# OpenTelemetry configuration
OTEL_ENABLED=false
OTEL_EXPORTER_TYPE=otlp
OTEL_PROTOCOL=grpc
OTEL_ENDPOINT=localhost:4317
OTEL_AUTH_HEADER=Bearer YOUR_API_KEY
OTEL_SAMPLING_RATE=1.0

